.products-header {
    background: linear-gradient(135deg, #0f0f0f, #1a1a2e, #16213e, #0f3460);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    position: relative;
    overflow: hidden;
}

/* Colores RGB animados cubriendo todo el header */
.products-header::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #ff0040, #ff8c00, #ffef00, #00ff88, #00cfff, #8b5cf6, #ff0040);
    background-size: 200% 100%;
    animation: rgb-slide 3s linear infinite;
    opacity: 0.25;
    pointer-events: none;
}

/* Desvanecido sutil solo en los bordes del header */
.products-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: 16px;
    box-shadow: inset 0 0 40px 20px rgba(0, 0, 0, 0.5);
}

@keyframes rgb-slide {
    0% { background-position: 0% 0; }
    100% { background-position: 200% 0; }
}

/* Animación de pulso para los botones */
@keyframes btn-glow-pulse {
    0%, 100% { box-shadow: 0 0 8px rgba(0, 207, 255, 0.2); }
    50% { box-shadow: 0 0 18px rgba(0, 207, 255, 0.5), 0 0 30px rgba(139, 92, 246, 0.2); }
}

/* Título con más brillo cyan */
.products-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 4px;
    color: #ffffff;
    text-shadow:
        0 0 15px rgba(0, 207, 255, 0.8),
        0 0 30px rgba(0, 207, 255, 0.5),
        0 0 60px rgba(0, 207, 255, 0.3),
        0 0 20px rgba(139, 92, 246, 0.4),
        2px 2px 0 rgba(0, 0, 0, 0.5);
    text-transform: uppercase;
    margin-bottom: 0.3rem;
    position: relative;
    z-index: 2;
}

.products-title-divider {
    height: 3px;
    border: none;
    border-radius: 2px;
    background: linear-gradient(to right, #00cfff, #8b5cf6, #ff0040, transparent);
    margin-bottom: 1rem;
    opacity: 0.7;
    position: relative;
    z-index: 2;
}

/* Botones oscuros con glow dentro del header */
.products-header .btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    animation: btn-glow-pulse 3s ease-in-out infinite;
    transition: all 0.3s ease;
}

.products-header .btn:hover {
    background: rgba(0, 207, 255, 0.2);
    border-color: rgba(0, 207, 255, 0.6);
    color: #fff;
    box-shadow: 0 0 20px rgba(0, 207, 255, 0.6), 0 0 40px rgba(139, 92, 246, 0.3);
    transform: scale(1.05);
    animation: none;
}

.products-header .btn.btn-primary {
    background: rgba(0, 207, 255, 0.15);
    border-color: rgba(0, 207, 255, 0.4);
}

.products-header .btn-primary:hover {
    background: rgba(0, 207, 255, 0.3);
    border-color: rgba(0, 207, 255, 0.7);
}

/* Botones de vista: activo vs inactivo */
.products-header .btn-outline-primary {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.7);
}

/* Controles dentro del header oscuro */
.products-header .form-control {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
}

.products-header .form-control::placeholder {
    color: rgba(255, 255, 255, 0.5);
}

.products-header .form-control:focus {
    background: rgba(255, 255, 255, 0.15);
    border-color: #00cfff;
    box-shadow: 0 0 8px rgba(0, 207, 255, 0.3);
    color: #fff;
}

.products-header .row {
    position: relative;
    z-index: 2;
}
